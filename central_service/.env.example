# ==============================================================================
# Magnetometer Central Service Environment Configuration
# ==============================================================================
# Copy this file to .env (e.g., cp .env.example .env) and adjust values as needed.

# --- Central Data Server Settings ---
HOST=0.0.0.0
PORT=8000
DB_FILE=magnetometer.db

# Optional Security API Key:
# If set, write endpoints (POST /api/v1/telemetry, /api/v1/nodes/update) require
# the header 'X-API-Key: <your_key>'. Read-only web dashboard and charts remain open.
# Leave blank for local offline network testing without authentication.
API_KEY=

# --- Edge Gateway Receiver Settings (gateway.py) ---
# Target URL for the central server API
CENTRAL_SERVER_URL=http://localhost:8000

# UDP Listener (Receives CSV telemetry stream from ESP32 WiFi nodes)
ENABLE_UDP=true
UDP_PORT=9876

# Serial / USB Listener (Reads directly from plugged-in ESP32 / Receiver MCU)
# Set ENABLE_SERIAL=true to enable serial ingestion.
# SERIAL_PORT can be:
#   - Empty / 'auto' / 'all': Automatically discovers all connected USB/CDC serial devices (/dev/ttyACM*, /dev/ttyUSB*, COM*)
#   - Single port: e.g. /dev/ttyACM0
#   - Multiple ports (comma-separated): e.g. /dev/ttyACM0,/dev/ttyACM1 or /dev/ttyACM0,/dev/ttyUSB0
ENABLE_SERIAL=false
SERIAL_PORT=
SERIAL_BAUD=921600

# Bluetooth LE Listener (Nordic UART Service)
# Requires 'bleak' Python package (pip install bleak)
ENABLE_BLE=false

[Unit]
Description=Magnetometer Edge Gateway (UDP/Serial/BLE Stream Ingestion)
After=network.target magnetometer-server.service
Wants=magnetometer-server.service

[Service]
Type=simple
WorkingDirectory=%WORKING_DIR%
EnvironmentFile=-%WORKING_DIR%/.env
ExecStart=%WORKING_DIR%/.venv/bin/python %WORKING_DIR%/gateway.py
Restart=always
RestartSec=3
LimitNOFILE=65536

# Standard Output & Error to journald (view with journalctl --user -u magnetometer-gateway -f)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=magnetometer-gateway

[Install]
WantedBy=default.target
